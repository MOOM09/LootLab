# LootHub local environment template - copy to .env and fill locally
# NEVER commit .env or real secrets.
APP_URL=http://localhost/LootLab/public
DB_HOST=localhost
DB_NAME=lootlab
DB_USER=root
DB_PASS=""

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_JOD_TO_USD_RATE=1.41

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost/LootLab/public/auth/google/callback

MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=YOUR_GMAIL@gmail.com
MAIL_PASSWORD="YOUR_GMAIL_APP_PASSWORD"
MAIL_FROM_ADDRESS=YOUR_GMAIL@gmail.com
MAIL_FROM_NAME="LootHub"

TEXTBEE_API_KEY=YOUR_TEXTBEE_API_KEY
TEXTBEE_DEVICE_ID=YOUR_TEXTBEE_DEVICE_ID

# Optional independent image generation server
PHOTOMAKER_GENERATE_URL=http://127.0.0.1:7861/generate
